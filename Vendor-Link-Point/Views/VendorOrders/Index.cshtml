@model IEnumerable<Vendor_Link_Point.Models.Rendeles>

@{
    ViewData["Title"] = "Beérkezett Rendelések";
}

<div class="container-fluid mt-4 mb-5 px-4">
    <h2 class="fw-bold mb-4"><i class="bi bi-shop text-success me-2"></i>Kereskedői Rendeléskezelő</h2>

    @if (!Model.Any())
    {
        <div class="alert alert-light border shadow-sm py-5 text-center">
            <i class="bi bi-inbox display-4 text-muted mb-3 d-block"></i>
            <h5 class="fw-bold">Jelenleg nincs egyetlen beérkezett rendelésed sem.</h5>
            <p class="text-muted">Amint a vásárlók vesznek valamit a termékeidből, itt fognak megjelenni!</p>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light text-muted">
                            <tr>
                                <th class="ps-4">Rendelésszám</th>
                                <th>Dátum</th>
                                <th>Vásárló adatai</th>
                                <th>Rendelt termékek</th>
                                <th>Fizetés & Összeg</th>
                                <th>Állapot</th>
                                <th class="text-end pe-4">Műveletek</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var rendeles in Model)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold">#@rendeles.Id</td>
                                    <td>@rendeles.Idopont.ToString("yyyy. MM. dd. HH:mm")</td>
                                    <td>
                                        <div class="fw-bold">@rendeles.Vasarlo.Nev</div>
                                        <div class="small text-muted"><i class="bi bi-geo-alt me-1"></i> @rendeles.SzallitasiCim</div>
                                        <div class="small text-muted"><i class="bi bi-envelope me-1"></i> @rendeles.Vasarlo.Email</div>
                                    </td>
                                    <td>
                                        <ul class="list-unstyled mb-0 small">
                                            @foreach (var tetel in rendeles.RendelesTetelek)
                                            {
                                                <!-- Csak akkor mutatjuk vastagon, ha az a mi (kereskedő) termékünk -->
                                                <li class="@(tetel.Termek.KereskedoId == User.FindFirst("KereskedoId")?.Value ? "fw-bold text-dark" : "text-muted")">
                                                    @tetel.Mennyiseg x @(tetel.Termek?.Nev ?? "Törölt")
                                                </li>
                                            }
                                        </ul>
                                    </td>
                                    <td>
                                        <div>@rendeles.FizetesiMod</div>
                                        <div class="fw-bold text-danger">@rendeles.Vegosszeg.ToString("C0", new System.Globalization.CultureInfo("hu-HU"))</div>
                                    </td>
                                    <td>
                                        @if (rendeles.Allapot == "Feldolgozás alatt")
                                        {
                                            <span class="badge bg-warning text-dark px-2 py-1"><i class="bi bi-hourglass-split me-1"></i> @rendeles.Allapot</span>
                                        }
                                        else if (rendeles.Allapot == "Csomagolás alatt")
                                        {
                                            <span class="badge bg-info text-dark px-2 py-1"><i class="bi bi-box-seam me-1"></i> @rendeles.Allapot</span>
                                        }
                                        else if (rendeles.Allapot == "Kiszállítás alatt")
                                        {
                                            <span class="badge bg-primary px-2 py-1"><i class="bi bi-truck me-1"></i> @rendeles.Allapot</span>
                                        }
                                        else if (rendeles.Allapot == "Kiszállítva")
                                        {
                                            <span class="badge bg-success px-2 py-1"><i class="bi bi-check-circle me-1"></i> @rendeles.Allapot</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger px-2 py-1"><i class="bi bi-x-circle me-1"></i> @rendeles.Allapot</span>
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        <a asp-action="Details" asp-route-id="@rendeles.Id" class="btn btn-sm btn-primary fw-bold shadow-sm">
                                            Részletek & Kezelés <i class="bi bi-arrow-right-short"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>