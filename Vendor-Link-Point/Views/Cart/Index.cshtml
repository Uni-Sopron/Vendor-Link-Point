@model Vendor_Link_Point.Models.Kosar

@{
    ViewData["Title"] = "Kosaram";
}

<div class="container mt-4 mb-5">
    <h2 class="fw-bold mb-4"><i class="bi bi-cart3 me-2"></i>Kosaram tartalma</h2>

    @if (!Model.Tetelek.Any())
    {
        <div class="alert alert-info shadow-sm border-0 py-4 text-center">
            <i class="bi bi-cart-x display-4 d-block mb-3 text-muted"></i>
            <h5 class="fw-bold">A kosarad jelenleg üres.</h5>
            <p>Ideje körülnézni a webshopban és megtalálni a legjobb ajánlatokat!</p>
            <a asp-controller="Products" asp-action="Index" class="btn btn-primary mt-2 fw-bold px-4">Tovább a Webshopba</a>
        </div>
    }
    else
    {
        <div class="row">
            <div class="col-lg-8 mb-4">
                <div class="card shadow-sm border-0">
                    <div class="card-body p-0">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="bg-light text-muted">
                                <tr>
                                    <th class="ps-4">Termék</th>
                                    <th class="text-center">Mennyiség</th>
                                    <th class="text-end">Egységár</th>
                                    <th class="text-end pe-4">Összesen</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var tetel in Model.Tetelek)
                                {
                                    <tr>
                                        <td class="ps-4 py-3">
                                            <div class="d-flex align-items-center">
                                                @if (!string.IsNullOrEmpty(tetel.Termek.KepUrl))
                                                {
                                                    <img src="@tetel.Termek.KepUrl" alt="@tetel.Termek.Nev" style="width: 50px; height: 50px; object-fit: contain;" class="me-3 border rounded p-1">
                                                }
                                                <div>
                                                    <h6 class="mb-0 fw-bold">@tetel.Termek.Nev</h6>
                                                    <small class="text-muted">@tetel.Termek.Kategoria</small>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="text-center fw-bold">@tetel.Mennyiseg db</td>
                                        <td class="text-end text-muted">@tetel.Termek.Ar.ToString("C0", new System.Globalization.CultureInfo("hu-HU"))</td>
                                        <td class="text-end fw-bold text-dark pe-4">@((tetel.Termek.Ar * tetel.Mennyiseg).ToString("C0", new System.Globalization.CultureInfo("hu-HU")))</td>
                                        <td class="text-end pe-4">
                                            <form asp-controller="Cart" asp-action="Remove" asp-route-id="@tetel.Termek.Id" method="post">
                                                <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card shadow-sm border-0 bg-primary text-white">
                    <div class="card-body p-4">
                        <h4 class="fw-bold border-bottom border-light pb-3 mb-3">Rendelés összesítése</h4>
                        <div class="d-flex justify-content-between mb-2">
                            <span>Termékek száma:</span>
                            <span class="fw-bold">@Model.OsszesDarabszam() db</span>
                        </div>
                        <div class="d-flex justify-content-between mb-3">
                            <span>Szállítás:</span>
                            <span class="text-warning fw-bold">Ingyenes</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center border-top border-light pt-3 mt-3">
                            <h5 class="mb-0">Végösszeg:</h5>
                            <h3 class="mb-0 fw-bold text-warning">@Model.OsszesitettAr().ToString("C0", new System.Globalization.CultureInfo("hu-HU"))</h3>
                        </div>

                        <a href="#" class="btn btn-warning btn-lg w-100 fw-bold text-dark mt-4 shadow">
                            Tovább a fizetéshez <i class="bi bi-arrow-right-circle ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>