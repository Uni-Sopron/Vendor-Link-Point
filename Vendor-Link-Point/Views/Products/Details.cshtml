@model Vendor_Link_Point.Models.Product

@{
    ViewData["Title"] = Model.Nev;
}

<nav aria-label="breadcrumb" class="mt-3 mb-4">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none">Főoldal</a></li>
        <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">Műszaki cikk</a></li>
        <li class="breadcrumb-item"><a asp-action="Index" asp-route-kategoria="@Model.Kategoria" class="text-decoration-none">@Model.Kategoria</a></li>
        <li class="breadcrumb-item active fw-bold" aria-current="page">@Model.Nev</li>
    </ol>
</nav>

<div class="card shadow-sm border-0 mb-5 p-4">
    <div class="row">
        <div class="col-md-5 d-flex align-items-center justify-content-center p-4" style="background-color: #f8f9fa; border-radius: 8px;">
            @if (string.IsNullOrEmpty(Model.KepUrl))
            {
                <i class="bi bi-image text-secondary" style="font-size: 8rem;"></i>
            }
            else
            {
                <img src="@Model.KepUrl"
                     onerror="this.onerror=null; this.src='https://placehold.co/600x400/f8f9fa/6c757d?text=Nincs+k%C3%A9p';"
                     alt="@Model.Nev"
                     class="img-fluid"
                     style="max-height: 400px; object-fit: contain;">
            }
        </div>

        <div class="col-md-7 ps-md-5 mt-4 mt-md-0">
            <h2 class="fw-bold mb-3">@Model.Nev</h2>
            <div class="mb-4 text-warning fs-5">
                <div class="mb-3 text-warning">
                    @{
                        double avg = ViewBag.AverageRating ?? 0;
                        int fullStars = (int)Math.Floor(avg);
                        bool halfStar = (avg - fullStars) >= 0.5;
                        int emptyStars = 5 - fullStars - (halfStar ? 1 : 0);
                    }
                    @if (Model.Ertekelesek.Any())
                    {
                        for (int i = 0; i < fullStars; i++)
                        {
                            <i class="bi bi-star-fill"></i>
                        }
                        if (halfStar)
                        {

                            <i class="bi bi-star-half"></i>
                        }
                        for (int i = 0; i < emptyStars; i++)
                        {

                            <i class="bi bi-star"></i>
                        }
                        <span class="text-dark ms-2 fw-bold">@avg.ToString("0.0")</span>
                    }
                    else
                    {
                        <i class="bi bi-star text-muted"></i>
                        <i class="bi bi-star text-muted"></i>
                        <i class="bi bi-star text-muted"></i>
                        <i class="bi bi-star text-muted"></i>
                        <i class="bi bi-star text-muted"></i>
                    }
                    <span class="text-muted ms-2 small">(@Model.Ertekelesek.Count értékelés)</span>
                </div>
            </div>

            <div class="row mb-4">
                <div class="col-sm-6">
                    <p class="mb-1 text-muted">Kategória: <span class="fw-bold text-dark">@Model.Kategoria</span></p>
                    <p class="mb-1 text-muted">Gyártó: <span class="fw-bold text-dark">@Model.Gyarto</span></p>
                </div>
                <div class="col-sm-6">
                    <p class="mb-1 text-muted">Állapot: <span class="text-success fw-bold"><i class="bi bi-check-circle-fill me-1"></i>Raktáron (@Model.Raktarkeszlet db)</span></p>
                </div>
            </div>

            <div class="border border-warning rounded-3 p-4 bg-white shadow-sm position-relative">
                <span class="badge bg-warning text-dark position-absolute top-0 start-0 translate-middle-y ms-3 px-3 py-2 border border-white fw-bold">Kiemelt ajánlat</span>

                <div class="d-flex justify-content-between align-items-center mt-2">
                    <div>
                        <h5 class="fw-bold text-primary mb-0"><i class="bi bi-shop me-2"></i>@ViewBag.Cegnev</h5>
                        <small class="text-success"><i class="bi bi-shield-check me-1"></i>Megbízható Bolt</small>
                    </div>
                    <div class="text-end">
                        <h3 class="text-danger fw-bold mb-0">@Model.Ar.ToString("C0", new System.Globalization.CultureInfo("hu-HU"))</h3>
                        <small class="text-muted">Ingyenes kiszállítás</small>
                    </div>
                </div>

                <form asp-controller="Cart" asp-action="Add" asp-route-id="@Model.Id" method="post">
                    <button type="submit" class="btn btn-warning btn-lg w-100 fw-bold shadow-sm text-dark transition-hover">
                        <i class="bi bi-cart-plus-fill me-2 fs-5"></i> Kosárba rakom
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<ul class="nav nav-tabs mb-4" id="productTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active fw-bold text-dark" id="desc-tab" data-bs-toggle="tab" data-bs-target="#desc" type="button" role="tab" aria-controls="desc" aria-selected="true">Termékleírás</button>
    </li>
</ul>
<div class="tab-content" id="productTabsContent">
    <div class="tab-pane fade show active p-3 bg-white border rounded-bottom border-top-0 shadow-sm" id="desc" role="tabpanel" aria-labelledby="desc-tab">
        <h5 class="fw-bold mb-3">Gyártói leírás és specifikációk</h5>
        <p style="line-height: 1.8;">@Model.Leiras</p>
    </div>
    <div class="card shadow-sm border-0 mt-5 mb-5">
        <div class="card-header bg-white border-bottom p-4 fw-bold fs-5">
            <i class="bi bi-chat-left-text text-primary me-2"></i> Vásárlói Értékelések
        </div>
        <div class="card-body p-4">

            @if (ViewBag.CanReview == true)
            {
                <div class="bg-light p-4 rounded mb-4 border">
                    <h6 class="fw-bold mb-3">Értékeld a terméket!</h6>
                    <form asp-action="AddReview" method="post">
                        <input type="hidden" name="productId" value="@Model.Id" />
                        <div class="mb-3">
                            <label class="form-label text-muted small fw-bold text-uppercase">Pontszám (1-5)</label>
                            <select name="pontszam" class="form-select w-auto fw-bold text-warning" required>
                                <option value="5">⭐⭐⭐⭐⭐ (Kiváló)</option>
                                <option value="4">⭐⭐⭐⭐ (Jó)</option>
                                <option value="3">⭐⭐⭐ (Közepes)</option>
                                <option value="2">⭐⭐ (Gyenge)</option>
                                <option value="1">⭐ (Rossz)</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-muted small fw-bold text-uppercase">Szöveges értékelés (Opcionális)</label>
                            <textarea name="szoveg" class="form-control" rows="3" placeholder="Írd le a tapasztalataidat a termékkel kapcsolatban (max. 500 karakter)..." maxlength="500"></textarea>
                        </div>
                        <button type="submit" class="btn btn-primary fw-bold px-4">Értékelés beküldése</button>
                    </form>
                </div>
            }
            else if (ViewBag.HasReviewed == true)
            {
                <div class="alert alert-success border-0 shadow-sm mb-4">
                    <i class="bi bi-check-circle-fill me-2"></i> Köszönjük, hogy már értékelted ezt a terméket!
                </div>
            }

            @if (Model.Ertekelesek != null && Model.Ertekelesek.Any())
            {
                <div class="list-group list-group-flush">
                    @foreach (var ertekeles in Model.Ertekelesek.OrderByDescending(e => e.Datum))
                    {
                        <div class="list-group-item px-0 py-3">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <strong><i class="bi bi-person-circle text-muted me-2"></i> @ertekeles.Vasarlo?.Nev</strong>
                                <small class="text-muted">@ertekeles.Datum.ToString("yyyy. MM. dd.")</small>
                            </div>
                            <div class="text-warning mb-2">
                                @for (int i = 0; i < ertekeles.Pontszam; i++)
                                {
                                    <i class="bi bi-star-fill"></i>
                                }
                                @for (int i = ertekeles.Pontszam; i < 5; i++)
                                {
                                    <i class="bi bi-star"></i>
                                }
                            </div>
                            @if (!string.IsNullOrEmpty(ertekeles.Szoveg))
                            {
                                <p class="mb-0 text-dark">@ertekeles.Szoveg</p>
                            }
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="text-muted mb-0">Még nem érkezett értékelés ehhez a termékhez. Légy te az első!</p>
            }
        </div>
    </div>
</div>