@model Vendor_Link_Point.ViewModels.WebshopViewModel

@{
    ViewData["Title"] = "Webshop";
}

<nav aria-label="breadcrumb" class="mt-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none">Főoldal</a></li>
        <li class="breadcrumb-item active" aria-current="page">Webshop @(!string.IsNullOrEmpty(Model.CurrentCategory) ? $" > {Model.CurrentCategory}" : "")</li>
    </ol>
</nav>

<div class="row mt-2">
    <div class="col-lg-3 col-md-4 mb-4">
        <form method="get" asp-action="Index" id="filterForm">
            <input type="hidden" name="kategoria" value="@Model.CurrentCategory" />

            @* Ezt a sort adjuk hozzá, hogy a keresés megmaradjon a szűréseknél is! *@
            @if (!string.IsNullOrEmpty(Context.Request.Query["kereses"]))
            {
                <input type="hidden" name="kereses" value="@Context.Request.Query["kereses"]" />
            }

            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-white border-bottom fw-bold">
                    <i class="bi bi-funnel text-primary me-2"></i>Kategóriák
                </div>
                <div class="list-group list-group-flush">
                    <a asp-action="Index" asp-route-kategoria="" class="list-group-item list-group-item-action @(string.IsNullOrEmpty(Model.CurrentCategory) ? "active bg-primary border-primary" : "") d-flex justify-content-between align-items-center">
                        Minden Termék
                    </a>
                    <a asp-action="Index" asp-route-kategoria="TV-k" class="list-group-item list-group-item-action @(Model.CurrentCategory == "TV-k" ? "active bg-primary border-primary" : "") d-flex justify-content-between align-items-center">
                        TV és Szórakozás <span class="badge bg-secondary rounded-pill">@Model.TvCount</span>
                    </a>
                    <a asp-action="Index" asp-route-kategoria="Könyvek" class="list-group-item list-group-item-action @(Model.CurrentCategory == "Könyvek" ? "active bg-primary border-primary" : "") d-flex justify-content-between align-items-center">
                        Könyvek <span class="badge bg-secondary rounded-pill">@Model.KonyvCount</span>
                    </a>
                    <a asp-action="Index" asp-route-kategoria="Játékok" class="list-group-item list-group-item-action @(Model.CurrentCategory == "Játékok" ? "active bg-primary border-primary" : "") d-flex justify-content-between align-items-center">
                        Játékok <span class="badge bg-secondary rounded-pill">@Model.JatekCount</span>
                    </a>
                </div>
            </div>

            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-white border-bottom fw-bold">Ár (Ft)</div>
                <div class="card-body p-3">
                    <div class="d-flex align-items-center mb-2">
                        <input type="number" class="form-control form-control-sm me-2" name="minAr" placeholder="Min" value="@Model.MinAr">
                        <span>-</span>
                        <input type="number" class="form-control form-control-sm ms-2" name="maxAr" placeholder="Max" value="@Model.MaxAr">
                    </div>
                    <button type="submit" class="btn btn-outline-primary btn-sm w-100 fw-bold">Ár szűrése</button>
                </div>
            </div>

            @if (Model.CurrentCategory == "TV-k")
            {
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-header bg-white border-bottom fw-bold">Képátló (col)</div>
                    <div class="card-body p-3">
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" name="meretek" value="kicsi" id="m1" onchange="this.form.submit()" @(Model.KivalasztottMeretek.Contains("kicsi") ? "checked" : "") @(Model.TvMeretKicsiCount == 0 && !Model.KivalasztottMeretek.Contains("kicsi") ? "disabled" : "")>
                            <label class="form-check-label @(Model.TvMeretKicsiCount == 0 && !Model.KivalasztottMeretek.Contains("kicsi") ? "text-muted" : "")" for="m1">
                                45" alatt (@Model.TvMeretKicsiCount)
                            </label>
                        </div>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" name="meretek" value="kozepes" id="m2" onchange="this.form.submit()" @(Model.KivalasztottMeretek.Contains("kozepes") ? "checked" : "") @(Model.TvMeretKozepesCount == 0 && !Model.KivalasztottMeretek.Contains("kozepes") ? "disabled" : "")>
                            <label class="form-check-label @(Model.TvMeretKozepesCount == 0 && !Model.KivalasztottMeretek.Contains("kozepes") ? "text-muted" : "")" for="m2">
                                45" - 55" (@Model.TvMeretKozepesCount)
                            </label>
                        </div>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" name="meretek" value="nagy" id="m3" onchange="this.form.submit()" @(Model.KivalasztottMeretek.Contains("nagy") ? "checked" : "") @(Model.TvMeretNagyCount == 0 && !Model.KivalasztottMeretek.Contains("nagy") ? "disabled" : "")>
                            <label class="form-check-label @(Model.TvMeretNagyCount == 0 && !Model.KivalasztottMeretek.Contains("nagy") ? "text-muted" : "")" for="m3">
                                56" - 65" (@Model.TvMeretNagyCount)
                            </label>
                        </div>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" name="meretek" value="extra" id="m4" onchange="this.form.submit()" @(Model.KivalasztottMeretek.Contains("extra") ? "checked" : "") @(Model.TvMeretExtraCount == 0 && !Model.KivalasztottMeretek.Contains("extra") ? "disabled" : "")>
                            <label class="form-check-label @(Model.TvMeretExtraCount == 0 && !Model.KivalasztottMeretek.Contains("extra") ? "text-muted" : "")" for="m4">
                                65" felett (@Model.TvMeretExtraCount)
                            </label>
                        </div>
                    </div>
                </div>
            }
        </form>
    </div>

    <div class="col-lg-9 col-md-8">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h3 class="fw-bold mb-0">@(string.IsNullOrEmpty(Model.CurrentCategory) ? "Minden Termék" : Model.CurrentCategory)</h3>
            <span class="text-muted">@Model.Termekek.Count() termék</span>
        </div>

        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-2 row-cols-xl-4 g-4 mb-5">
            @if (!Model.Termekek.Any())
            {
                <div class="col-12">
                    <div class="alert alert-warning border-0 shadow-sm">A megadott szűrési feltételeknek egyetlen termék sem felel meg. Próbálj módosítani a szűrőkön!</div>
                </div>
            }
            else
            {
                foreach (var item in Model.Termekek)
                {
                    <div class="col">
                        <div class="card h-100 shadow-sm border-0 transition-hover">
                            <a asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none">
                                @if (string.IsNullOrEmpty(item.KepUrl))
                                {
                                    <div class="bg-light text-secondary d-flex align-items-center justify-content-center rounded-top" style="height: 160px;">
                                        <i class="bi bi-image fs-1"></i>
                                    </div>
                                }
                                else
                                {
                                    <img src="@item.KepUrl"
                                         onerror="this.onerror=null; this.src='https://placehold.co/400x300/f8f9fa/6c757d?text=Nincs+k%C3%A9p';"
                                         class="card-img-top p-3 transition-hover"
                                         alt="@item.Nev"
                                         style="height: 160px; object-fit: contain; background: #fff;">
                                }
                            </a>
                            <div class="card-body d-flex flex-column p-3 bg-white">
                                <a asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none text-dark">
                                    <h6 class="card-title text-truncate fw-bold mb-1" title="@item.Nev">@item.Nev</h6>
                                </a>
                                <p class="card-text text-muted small mb-3">@item.Gyarto</p>
                                <h5 class="text-danger mt-auto fw-bold mb-0">@item.Ar.ToString("C0", new System.Globalization.CultureInfo("hu-HU"))</h5>
                            </div>
                            <div class="card-footer bg-white border-top-0 p-3 pt-0">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-primary w-100 fw-bold">
                                    Megnézem
                                </a>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>

<style>
    .transition-hover {
        transition: transform 0.2s, box-shadow 0.2s;
    }

        .transition-hover:hover {
            transform: translateY(-3px);
            box-shadow: 0 .5rem 1rem rgba(0,0,0,.15) !important;
        }
</style>