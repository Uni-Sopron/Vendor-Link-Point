@model IEnumerable<Vendor_Link_Point.Models.Product>

@{
    ViewData["Title"] = "Termékek";
}

<div class="row mt-4">
    
    <div class="col-lg-2 col-md-3 mb-4">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-dark text-white rounded-top">
                <h5 class="mb-0">Szűrés</h5>
            </div>
            <ul class="list-group list-group-flush border">
                <a href="#" class="list-group-item list-group-item-action active">Minden Kategória</a>
                <a href="#" class="list-group-item list-group-item-action">TV-k</a>
                <a href="#" class="list-group-item list-group-item-action">Könyvek</a>
                <a href="#" class="list-group-item list-group-item-action">Játékok</a>
            </ul>
        </div>
    </div>

    <div class="col-lg-10 col-md-9">
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-4">
            
            @if (!Model.Any())
            {
                <div class="col-12">
                    <div class="alert alert-info">Jelenleg nincs elérhető termék a webshopban.</div>
                </div>
            }
            else
            {
                @foreach (var item in Model)
                {
                    <div class="col">
                        <div class="card h-100 shadow-sm border-0 bg-light">
                            @if (string.IsNullOrEmpty(item.KepUrl))
                            {
                                <div class="bg-secondary text-white d-flex align-items-center justify-content-center rounded-top" style="height: 180px;">
                                    <span>Nincs kép</span>
                                </div>
                            }
                            else
                            {
                                <img src="@item.KepUrl" class="card-img-top rounded-top" alt="@item.Nev" style="height: 180px; object-fit: cover;">
                            }

                            <div class="card-body d-flex flex-column p-3 bg-white">
                                <h6 class="card-title text-truncate" title="@item.Nev">@item.Nev</h6>
                                <p class="card-text text-muted small mb-2">@item.Kategoria | @item.Gyarto</p>
                                <h6 class="text-primary mt-auto fw-bold">@item.Ar.ToString("C0", new System.Globalization.CultureInfo("hu-HU"))</h6>
                            </div>
                            <div class="card-footer bg-white border-top-0 d-grid p-2 rounded-bottom">
                                <a href="#" class="btn btn-sm btn-outline-success">Kosárba</a>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>