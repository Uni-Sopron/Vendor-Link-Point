@model IEnumerable<Vendor_Link_Point.Models.Product>

@{
    ViewData["Title"] = "Termékek";
}

<div class="row mt-4">
    <div class="col-md-3">
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-dark text-white">
                <h5 class="mb-0">Szűrés</h5>
            </div>
            <ul class="list-group list-group-flush">
                <a href="#" class="list-group-item list-group-item-action active">Minden Kategória</a>
                <a href="#" class="list-group-item list-group-item-action">TV-k</a>
                <a href="#" class="list-group-item list-group-item-action">Könyvek</a>
                <a href="#" class="list-group-item list-group-item-action">Játékok</a>
            </ul>
        </div>
    </div>

    <div class="col-md-9">
        <div class="row row-cols-1 row-cols-md-3 g-4">
            
            @if (!Model.Any())
            {
                <div class="col-12">
                    <div class="alert alert-info">Jelenleg nincs elérhető termék a webshopban.</div>
                </div>
            }
            else
            {
                @foreach (var item in Model)
                {
                    <div class="col">
                        <div class="card h-100 shadow-sm">
                            @if (string.IsNullOrEmpty(item.KepUrl))
                            {
                                <div class="bg-secondary text-white d-flex align-items-center justify-content-center" style="height: 200px;">
                                    <span>Nincs kép</span>
                                </div>
                            }
                            else
                            {
                                <img src="@item.KepUrl" class="card-img-top" alt="@item.Nev" style="height: 200px; object-fit: cover;">
                            }

                            <div class="card-body d-flex flex-column">
                                <h5 class="card-title">@item.Nev</h5>
                                <p class="card-text text-muted small">@item.Kategoria | Gyártó: @item.Gyarto</p>
                                <h6 class="text-primary mt-auto fw-bold">@item.Ar.ToString("C0", new System.Globalization.CultureInfo("hu-HU"))</h6>
                            </div>
                            <div class="card-footer bg-white border-top-0 d-grid">
                                <a href="#" class="btn btn-outline-success">Kosárba</a>
                            </div>
                        </div>
                    </div>
                }
            }

        </div>
    </div>
</div>