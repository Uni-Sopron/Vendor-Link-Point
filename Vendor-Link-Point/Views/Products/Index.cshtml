@model IEnumerable<Vendor_Link_Point.Models.Product>

@{
    ViewData["Title"] = "Webshop";
    var currentCategory = ViewData["CurrentCategory"] as string;
}

<nav aria-label="breadcrumb" class="mt-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none">Főoldal</a></li>
        <li class="breadcrumb-item active" aria-current="page">Webshop @(!string.IsNullOrEmpty(currentCategory) ? $" > {currentCategory}" : "")</li>
    </ol>
</nav>

<div class="row mt-2">
    <div class="col-lg-3 col-md-4 mb-4">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white border-bottom fw-bold">
                <i class="bi bi-funnel text-primary me-2"></i>Kategóriák
            </div>
            <div class="list-group list-group-flush">
                <a asp-action="Index" asp-route-kategoria="" class="list-group-item list-group-item-action @(string.IsNullOrEmpty(currentCategory) ? "active bg-primary border-primary" : "")">
                    Minden Termék
                </a>
                <a asp-action="Index" asp-route-kategoria="TV-k" class="list-group-item list-group-item-action @(currentCategory == "TV-k" ? "active bg-primary border-primary" : "")">
                    TV és Szórakozás
                </a>
                <a asp-action="Index" asp-route-kategoria="Könyvek" class="list-group-item list-group-item-action @(currentCategory == "Könyvek" ? "active bg-primary border-primary" : "")">
                    Könyvek
                </a>
                <a asp-action="Index" asp-route-kategoria="Játékok" class="list-group-item list-group-item-action @(currentCategory == "Játékok" ? "active bg-primary border-primary" : "")">
                    Játékok
                </a>
            </div>
        </div>

        @if (currentCategory == "TV-k")
        {
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-white border-bottom fw-bold">TV Specifikációk</div>
                <div class="card-body p-3">
                    <h6 class="text-muted small fw-bold text-uppercase">Képátló</h6>
                    <div class="form-check mb-2"><input class="form-check-input" type="checkbox"><label class="form-check-label">55" - 65"</label></div>
                    <div class="form-check mb-3"><input class="form-check-input" type="checkbox"><label class="form-check-label">65" felett</label></div>
                    <h6 class="text-muted small fw-bold text-uppercase">Felbontás</h6>
                    <div class="form-check"><input class="form-check-input" type="checkbox"><label class="form-check-label">4K Ultra HD</label></div>
                </div>
            </div>
        }
        else if (currentCategory == "Könyvek")
        {
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-white border-bottom fw-bold">Könyv Szűrők</div>
                <div class="card-body p-3">
                    <div class="form-check mb-2"><input class="form-check-input" type="checkbox"><label class="form-check-label">Raktáron lévő</label></div>
                    <div class="form-check"><input class="form-check-input" type="checkbox"><label class="form-check-label">Keménytáblás</label></div>
                </div>
            </div>
        }
    </div>

    <div class="col-lg-9 col-md-8">
        <h3 class="fw-bold mb-4">@(string.IsNullOrEmpty(currentCategory) ? "Minden Termék" : currentCategory)</h3>

        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-2 row-cols-xl-4 g-4 mb-5">
            @if (!Model.Any())
            {
                <div class="col-12">
                    <div class="alert alert-warning border-0 shadow-sm">Ebben a kategóriában jelenleg nincs elérhető termék.</div>
                </div>
            }
            else
            {
                foreach (var item in Model)
                {
                    <div class="col">
                        <div class="card h-100 shadow-sm border-0 transition-hover">
                            <a asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none">
                                @if (string.IsNullOrEmpty(item.KepUrl))
                                {
                                    <div class="bg-light text-secondary d-flex align-items-center justify-content-center rounded-top" style="height: 160px;">
                                        <i class="bi bi-image fs-1"></i>
                                    </div>
                                }
                                else
                                {
                                    <img src="@item.KepUrl" class="card-img-top rounded-top p-2" alt="@item.Nev" style="height: 160px; object-fit: contain; background: #fff;">
                                }
                            </a>

                            <div class="card-body d-flex flex-column p-3 bg-white">
                                <a asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none text-dark">
                                    <h6 class="card-title text-truncate fw-bold mb-1" title="@item.Nev">@item.Nev</h6>
                                </a>
                                <p class="card-text text-muted small mb-3">@item.Gyarto</p>
                                <h5 class="text-danger mt-auto fw-bold mb-0">@item.Ar.ToString("C0", new System.Globalization.CultureInfo("hu-HU"))</h5>
                            </div>

                            <div class="card-footer bg-white border-top-0 p-3 pt-0">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-primary w-100 fw-bold">
                                    Megnézem
                                </a>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>

<style>
    .transition-hover {
        transition: transform 0.2s, box-shadow 0.2s;
    }

        .transition-hover:hover {
            transform: translateY(-3px);
            box-shadow: 0 .5rem 1rem rgba(0,0,0,.15) !important;
        }
</style>