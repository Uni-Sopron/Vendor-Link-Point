@{
    ViewData["Title"] = "Elérhetőség";
}

<div class="container mt-5 mb-5">
    <div class="text-center mb-5">
        <h2 class="fw-bold">Lépj velünk kapcsolatba!</h2>
        <p class="text-muted">Kérdésed van egy rendeléssel vagy a platform működésével kapcsolatban? Ügyfélszolgálatunk készséggel áll rendelkezésedre.</p>
    </div>

    <div class="row g-4">
        <div class="col-md-4">
            <div class="card shadow-sm border-0 h-100 text-center p-4 transition-hover">
                <i class="bi bi-geo-alt-fill text-primary mb-3" style="font-size: 3rem;"></i>
                <h5 class="fw-bold">Központunk</h5>
                <p class="text-muted mb-0">9400 Sopron,<br />Bajcsy-Zsilinszky utca 4.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm border-0 h-100 text-center p-4 transition-hover">
                <i class="bi bi-telephone-fill text-primary mb-3" style="font-size: 3rem;"></i>
                <h5 class="fw-bold">Telefonszám</h5>
                <p class="text-muted mb-0">+36 99 123 456<br />(H-P: 08:00 - 16:00)</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm border-0 h-100 text-center p-4 transition-hover">
                <i class="bi bi-envelope-paper-heart-fill text-primary mb-3" style="font-size: 3rem;"></i>
                <h5 class="fw-bold">E-mail</h5>
                <p class="text-muted mb-0">info@vendor-link-point.hu<br />support@vendor.hu</p>
            </div>
        </div>
    </div>
</div>

<style>
    .transition-hover {
        transition: transform 0.2s, box-shadow 0.2s;
    }

        .transition-hover:hover {
            transform: translateY(-5px);
            box-shadow: 0 .5rem 1rem rgba(0,0,0,.15) !important;
        }
</style>