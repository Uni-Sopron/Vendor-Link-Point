@model IEnumerable<Vendor_Link_Point.Models.Rendeles>

@{
    ViewData["Title"] = "Saját Rendeléseim";
}

<div class="container mt-4 mb-5">
    <h2 class="fw-bold mb-4"><i class="bi bi-box2-heart me-2 text-primary"></i>Saját Rendeléseim</h2>

    @if (!Model.Any())
    {
        <div class="alert alert-light border shadow-sm py-5 text-center">
            <i class="bi bi-receipt display-4 text-muted mb-3 d-block"></i>
            <h5 class="fw-bold">Még nem adtál le egyetlen rendelést sem.</h5>
            <p class="text-muted">Fedezd fel a webshopunkat, és csapj le a legjobb ajánlatokra!</p>
            <a asp-controller="Products" asp-action="Index" class="btn btn-primary mt-2 fw-bold px-4">Tovább a Webshopba</a>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var rendeles in Model)
            {
                <div class="col-12 mb-4">
                    <div class="card shadow-sm border-0">
                        <div class="card-header bg-light border-bottom p-3 d-flex flex-column flex-md-row justify-content-between align-items-md-center">
                            <div>
                                <span class="text-muted small d-block mb-1">Rendelés azonosító: <strong>#@rendeles.Id</strong></span>
                                <h6 class="mb-0 fw-bold">@rendeles.Idopont.ToString("yyyy. MMMM dd. HH:mm")</h6>
                            </div>
                            <div class="mt-2 mt-md-0 text-md-end">
                                @if (rendeles.Allapot == "Feldolgozás alatt")
                                {
                                    <span class="badge bg-warning text-dark px-3 py-2 fs-6 mb-2 d-inline-block"><i class="bi bi-hourglass-split me-1"></i> @rendeles.Allapot</span>
                                }
                                else if (rendeles.Allapot == "Csomagolás alatt")
                                {
                                    <span class="badge bg-info text-dark px-3 py-2 fs-6 mb-2 d-inline-block"><i class="bi bi-box-seam me-1"></i> @rendeles.Allapot</span>
                                }
                                else if (rendeles.Allapot == "Kiszállítás alatt")
                                {
                                    <span class="badge bg-primary px-3 py-2 fs-6 mb-2 d-inline-block"><i class="bi bi-truck me-1"></i> @rendeles.Allapot</span>
                                }
                                else if (rendeles.Allapot == "Kiszállítva")
                                {
                                    <span class="badge bg-success px-3 py-2 fs-6 mb-2 d-inline-block"><i class="bi bi-check-circle me-1"></i> @rendeles.Allapot</span>
                                }
                                else if (rendeles.Allapot == "Lemondva")
                                {
                                    <span class="badge bg-danger px-3 py-2 fs-6 mb-2 d-inline-block"><i class="bi bi-x-circle me-1"></i> @rendeles.Allapot</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary px-3 py-2 fs-6 mb-2 d-inline-block">@rendeles.Allapot</span>
                                }
                                <h5 class="fw-bold text-danger mb-0">@rendeles.Vegosszeg.ToString("C0", new System.Globalization.CultureInfo("hu-HU"))</h5>
                            </div>
                        </div>

                        <div class="card-body p-0">
                            <ul class="list-group list-group-flush">
                                @foreach (var tetel in rendeles.RendelesTetelek)
                                {
                                    <li class="list-group-item p-3 d-flex align-items-center">
                                        @if (tetel.Termek != null && !string.IsNullOrEmpty(tetel.Termek.KepUrl))
                                        {
                                            <img src="@tetel.Termek.KepUrl" alt="@tetel.Termek.Nev" class="border rounded p-1 me-3" style="width: 60px; height: 60px; object-fit: contain;">
                                        }
                                        else
                                        {
                                            <div class="bg-light text-secondary d-flex align-items-center justify-content-center rounded me-3" style="width: 60px; height: 60px;">
                                                <i class="bi bi-image fs-4"></i>
                                            </div>
                                        }

                                        <div class="flex-grow-1">
                                            <h6 class="fw-bold mb-1">@(tetel.Termek?.Nev ?? "Törölt termék")</h6>
                                            <small class="text-muted">@tetel.Mennyiseg db x @tetel.Egysegar.ToString("C0", new System.Globalization.CultureInfo("hu-HU"))</small>
                                        </div>
                                        <div class="fw-bold">
                                            @((tetel.Mennyiseg * tetel.Egysegar).ToString("C0", new System.Globalization.CultureInfo("hu-HU")))
                                        </div>
                                    </li>
                                }
                            </ul>
                        </div>

                        <div class="card-footer bg-white text-muted small p-3">
                            <div class="row align-items-center">
                                <div class="col-md-8">
                                    <div class="mb-1"><strong><i class="bi bi-geo-alt me-1"></i> Szállítási cím:</strong> @rendeles.SzallitasiCim</div>
                                    <div><strong><i class="bi bi-credit-card me-1"></i> Fizetési mód:</strong> @rendeles.FizetesiMod</div>
                                </div>
                                <div class="col-md-4 text-md-end mt-3 mt-md-0">
                                    <a asp-action="Details" asp-route-id="@rendeles.Id" class="btn btn-outline-primary btn-sm fw-bold w-100">
                                        Részletek és opciók <i class="bi bi-arrow-right ms-1"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>